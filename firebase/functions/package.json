{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions for TFG VDAY (Shopify webhook, staff notice FCM)",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "serve": "firebase -P tfg-sales-record emulators:start --only functions",
    "shell": "firebase -P tfg-sales-record functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P tfg-sales-record functions:log"
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
