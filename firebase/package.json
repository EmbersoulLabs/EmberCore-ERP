{
  "name": "embercore-firebase",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage \"node --test test/storage.rules.test.js\"",
    "test:firebase": "firebase emulators:exec --only firestore,storage \"node --test --test-concurrency=1 test/firestore.rules.test.js test/storage.rules.test.js test/init_counters.integration.test.js test/order_counter.integration.test.js\"",
    "init:counters": "node scripts/init_counters.js",
    "init:counters:dry-run": "node scripts/init_counters.js --dry-run",
    "seed:product-categories:production": "node scripts/seed_product_categories.js --project tfg-sales-record",
    "seed:product-categories:production:force": "node scripts/seed_product_categories.js --project tfg-sales-record --force",
    "init:counters:emulator": "firebase emulators:exec --only firestore \"node scripts/init_counters.js\"",
    "verify:peak": "node scripts/verify_peak_readiness.js",
    "fix:user-ids": "node scripts/fix_user_profile_ids.js",
    "fix:user-ids:dry-run": "node scripts/fix_user_profile_ids.js --dry-run",
    "backfill:company-ref": "node scripts/backfill_company_ref.js",
    "backfill:company-ref:dry-run": "node scripts/backfill_company_ref.js --dry-run",
    "backfill:company-ref:staging": "node scripts/backfill_company_ref.js --project tfg-vday-record-staging --company-id staging_company",
    "backfill:company-ref:staging:dry-run": "node scripts/backfill_company_ref.js --project tfg-vday-record-staging --company-id staging_company --dry-run",
    "backfill:material-cost-snapshot": "node scripts/backfill_material_cost_snapshot.js",
    "backfill:material-cost-snapshot:dry-run": "node scripts/backfill_material_cost_snapshot.js --dry-run",
    "backfill:material-cost-snapshot:staging": "node scripts/backfill_material_cost_snapshot.js --project tfg-vday-record-staging --company-id staging_company",
    "backfill:material-cost-snapshot:staging:dry-run": "node scripts/backfill_material_cost_snapshot.js --project tfg-vday-record-staging --company-id staging_company --dry-run",
    "verify:company-ref": "node scripts/verify_company_ref_backfill.js",
    "verify:company-ref:dry-run": "node scripts/verify_company_ref_backfill.js --json",
    "verify:company-ref:staging": "node scripts/verify_company_ref_backfill.js --project tfg-vday-record-staging --company-id staging_company",
    "verify:company-ref:production": "node scripts/verify_company_ref_backfill.js --project tfg-sales-record --strict",
    "verify:company-ref:staging:strict": "node scripts/verify_company_ref_backfill.js --project tfg-vday-record-staging --company-id staging_company --strict",
    "smoke:staging": "node scripts/staging_smoke_check.js",
    "check:pre-release": "npm run test:firebase",
    "check:pre-release:full": "npm run verify:company-ref:production && npm run test:firebase",
    "create:driver": "node scripts/create_driver_user.js",
    "bootstrap:staging": "node scripts/bootstrap_staging_admin.js --project tfg-vday-record-staging",
    "bootstrap:staging:dry-run": "node scripts/bootstrap_staging_admin.js --project tfg-vday-record-staging --dry-run",
    "bootstrap:embercore:cli": "node scripts/bootstrap_embercore_cli.js",
    "smoke:embercore": "node scripts/embercore_smoke_check.js",
    "reset:permissions:staging:dry-run": "node scripts/reset_permission_overrides.js --project tfg-vday-record-staging --mode deny-all --dry-run",
    "reset:permissions:staging": "node scripts/reset_permission_overrides.js --project tfg-vday-record-staging --mode deny-all",
    "clear:permissions:staging:dry-run": "node scripts/reset_permission_overrides.js --project tfg-vday-record-staging --mode clear --dry-run",
    "clear:permissions:staging": "node scripts/reset_permission_overrides.js --project tfg-vday-record-staging --mode clear",
    "check:storage:staging": "node scripts/check_storage_setup.js --project tfg-vday-record-staging",
    "check:storage:production": "node scripts/check_storage_setup.js --project tfg-sales-record",
    "sample:product-images": "node scripts/sample_product_images.js --project tfg-sales-record",
    "sample:product-images:staging": "node scripts/sample_product_images.js --project tfg-vday-record-staging",
    "repair:product-images": "node scripts/repair_product_images.js --project tfg-sales-record",
    "repair:product-images:dry-run": "node scripts/repair_product_images.js --project tfg-sales-record --dry-run",
    "repair:product-images:client": "node scripts/repair_product_images_client.js --project production",
    "repair:product-images:client:staging": "node scripts/repair_product_images_client.js --project staging --email staging.admin@tfg-vday.test",
    "apply:storage:cors:production": "node scripts/apply_storage_cors.js --project tfg-sales-record",
    "apply:storage:cors:staging": "node scripts/apply_storage_cors.js --project tfg-vday-record-staging",
    "test:storage:upload": "node scripts/test_storage_upload_client.js",
    "set:user-role": "node scripts/set_user_role.js",
    "sync:staff-claims": "node scripts/sync_staff_auth_claims.js --project tfg-sales-record",
    "sync:staff-claims:dry-run": "node scripts/sync_staff_auth_claims.js --project tfg-sales-record --dry-run",
    "deploy:rules:staging:only": "firebase deploy --only firestore:rules,storage --project staging",
    "deploy:rules:staging": "npm run verify:company-ref:staging:strict && npm run deploy:rules:staging:only",
    "deploy:rules:production:only": "firebase deploy --only firestore:rules,storage --project production",
    "deploy:rules:production": "npm run verify:company-ref:production && npm run deploy:rules:production:only",
    "deploy:storage:staging": "firebase deploy --only storage --project staging",
    "deploy:storage:production": "firebase deploy --only storage --project production",
    "deploy:hosting:staging": "firebase deploy --only hosting --project staging",
    "deploy:hosting:production": "firebase deploy --only hosting --project production",
    "deploy:staging": "npm run verify:company-ref:staging:strict && firebase deploy --only hosting,firestore:rules,storage --project staging",
    "deploy:production": "npm run verify:company-ref:production && firebase deploy --only hosting,firestore:rules,storage --project production",
    "test:shopify": "node --test test/shopify_webhook.test.js",
    "config:shopify:staging": "node scripts/configure_shopify_webhook.js --env staging",
    "config:shopify:staging:verify": "node scripts/configure_shopify_webhook.js --env staging --verify-only",
    "deploy:functions:staging": "firebase deploy --only functions --project staging",
    "deploy:functions:production": "firebase deploy --only functions --project production",
    "deploy:rules:embercore": "firebase deploy --only firestore:rules,firestore:indexes,storage --project embercore-erp",
    "deploy:functions:embercore": "firebase deploy --only functions --project embercore-erp",
    "deploy:hosting:embercore": "firebase deploy --only hosting --project embercore-erp",
    "deploy:embercore": "firebase deploy --only hosting,firestore:rules,firestore:indexes,storage,functions --project embercore-erp"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.6.0",
    "firebase-tools": "^14.0.0"
  }
}
